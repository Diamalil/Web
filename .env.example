# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=GANTI_DENGAN_SECRET_RANDOM_MINIMAL_48_BYTE
TRUST_PROXY=0

# SQLite
DATABASE_FILE=./data/buku-kas.sqlite
SESSION_DATABASE_FILE=./data/sessions.sqlite

# Admin: contoh LAN; ganti/tambah CIDR IP publik admin saat deployment.
# Kosong = default loopback + jaringan privat.
ADMIN_ALLOWED_CIDRS=

# Email transaksi. console hanya untuk development lokal (tautan tampil di terminal).
# Untuk produksi, gunakan resend dan domain pengirim yang sudah diverifikasi.
EMAIL_PROVIDER=console
EMAIL_FROM=Buku Kas <onboarding@resend.dev>
RESEND_API_KEY=

# Google OAuth sengaja nonaktif. Ubah ke true hanya saat memang akan diaktifkan.
ENABLE_GOOGLE_OAUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backup database penuh
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
