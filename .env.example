# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Supabase Auth (publishable key is safe for browser use; secret key stays server-only)
SUPABASE_URL=https://dvtnxezautjkeshsbdyk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_7i0lsZhsTIXh5e0391I19w_f7dAesnz
SUPABASE_SECRET_KEY=
