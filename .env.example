# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SESSION_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARACTERS
DATABASE_FILE=./data/buku-kas.sqlite
SESSION_DATABASE_FILE=./data/sessions.sqlite
APP_BASE_URL=http://localhost:3000

# Google OAuth: create OAuth 2.0 Web client in Google Cloud Console.
# Authorized redirect URI: ${APP_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin network policy.
# Default (when empty): loopback + RFC1918 private LAN + IPv6 ULA.
# For remote admin access, add the admin's trusted static public IP/CIDR,
# e.g. 203.0.113.10/32. Do NOT use 0.0.0.0/0 unless you deliberately want
# admin login reachable from every network.
ADMIN_ALLOWED_CIDRS=

# Set to 1 only when the app is behind exactly one trusted reverse proxy.
# Keep 0 for direct LAN/VPS access. Never trust arbitrary forwarded headers.
TRUST_PROXY=0

# Used only by `npm run create-admin` to create the first admin account.
# Do not leave this in the production .env after the admin is created.
ADMIN_BOOTSTRAP_PASSWORD=
