# FeeKu web server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Supabase Auth and PostgreSQL Data API
SUPABASE_URL=https://dvtnxezautjkeshsbdyk.supabase.co
# Preferred: use the project's sb_publishable_ key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backward compatibility: if your existing .env uses SUPABASE_ANON_KEY, it is still accepted.
# Server-only secret key. Required for Vercel sessions, trusted admin operations, and one-time SQLite import.
SUPABASE_SECRET_KEY=
SESSION_SECRET=GANTI_DENGAN_SECRET_RANDOM_MINIMAL_48_BYTE

# SQLite is no longer the live business database.
# Local development defaults to SQLite. Vercel automatically selects Supabase sessions.
SESSION_STORE=sqlite
SESSION_DATABASE_FILE=./data/sessions.sqlite
# Legacy SQLite source path used only by scripts/migrate-sqlite-to-postgres.js.
DATABASE_FILE=./data/buku-kas.sqlite
MIGRATION_BACKUP_DIR=./backups

# Admin: comma-separated CIDR allowlist. Empty = loopback + private LAN + IPv6 ULA/link-local.
ADMIN_ALLOWED_CIDRS=
TRUST_PROXY=0

# Set true only after Google provider is configured in Supabase Auth.
ENABLE_GOOGLE_OAUTH=false

# Legacy SQLite backup command retention (backup:sqlite-legacy).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
