{
  "name": "buku-kas-website",
  "version": "1.2.0",
  "private": true,
  "description": "Website Buku Kas dengan verifikasi email, pemulihan akun, panel admin, dan isolasi data pengguna.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "create-admin": "node scripts/create-admin.js",
    "check": "node --check server.js && node --check public/app.js && node --check scripts/create-admin.js && node --check scripts/import-legacy-sqlite.js && node --check scripts/backup-database.js",
    "backup": "node scripts/backup-database.js"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "sqlite3@5.1.7": true,
    "sqlite3@6.0.1": true
  }
}
